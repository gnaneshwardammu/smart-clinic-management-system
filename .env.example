# Copy this file to ".env" (which is git-ignored) and replace the placeholders.
# Never commit the real .env file.

# Used by docker-compose.yml and as the MySQL password for local runs
MYSQL_ROOT_PASSWORD=dammu

# At least 32 random characters. PowerShell generator:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters

# Optional overrides for running the app directly with Maven (see README)
# DB_URL=jdbc:mysql://localhost:3306/capstone?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=change_me_mysql_password
# MONGODB_URI=mongodb://localhost:27017/clinic_prescriptions
# SERVER_PORT=8081
